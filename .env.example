# Reference only: never commit real credentials.
# Node production service needs no Bluesky credentials or .env loader.
# PORT is normally supplied by the hosting platform.
# FEED_URI is an optional override; leave unset to retain the existing feed.
# PORT=8080
# FEED_URI=at://did:plc:YOUR_ACCOUNT_DID/app.bsky.feed.generator/YOUR_FEED_RKEY

# Active Python collector / registration-repair scripts.
# Export these in your shell; those scripts do not load .env automatically.
# Scheduled workflows obtain them from GitHub repository secrets.
BSKY_APP_USERNAME=''
BSKY_APP_PASSWORD=''

# Legacy Python scaffold settings below are not required by the Node service.
# Do not use the legacy publisher to update the existing live registration.
HOSTNAME='feed.example.com'
FEED_URI='at://did:plc:abcde.../app.bsky.feed.generator/example-fid-name...'
HANDLE=''
PASSWORD=''
RECORD_NAME=''
DISPLAY_NAME=''
DESCRIPTION='powered by The AT Protocol SDK for Python'
AVATAR_PATH=''
SERVICE_DID=''
ACCEPTS_INTERACTIONS='false'
IS_VIDEO_FEED='false'
#IGNORE_REPLY_POSTS='true'
#IGNORE_ARCHIVED_POSTS='true'
